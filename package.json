{
  "name": "brewsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "create-user": "node --env-file=.env.local scripts/create-user.mjs",
    "set-password": "node --env-file=.env.local scripts/set-password.mjs",
    "backfill-gallery": "node --env-file=.env.local scripts/backfill-gallery.mjs",
    "test:offers": "node --env-file=.env.local scripts/test-offers.mjs",
    "test:menu": "node --env-file=.env.local scripts/test-menu.mjs",
    "test": "npm run test:cafe && npm run test:menu && npm run test:offers && npm run test:uploads",
    "test:uploads": "node --env-file=.env.local scripts/test-uploads.mjs",
    "import-cafe": "node --env-file=.env.local scripts/import-cafe.mjs",
    "test:cafe": "node --env-file=.env.local scripts/test-cafe.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
